              "metadata": {
                "operationMetadataId": "8f2a1c10-0012-4a10-9b10-000000000012"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord"
                },
                "parameters": {
                  "entityName": "dpa_invoices",
                  "recordId": "@triggerOutputs()?['body/dpa_invoiceid']",
                  "item/dpa_processingstatus": 100000003,
                  "item/dpa_amountdue": "@outputs('Parse_invoice_extraction')?['amountDue']",
                  "item/dpa_billtoaddress": "@outputs('Parse_invoice_extraction')?['billToAddress']",
                  "item/dpa_billtoname": "@outputs('Parse_invoice_extraction')?['billToName']",
                  "item/dpa_currencycode": "@outputs('Parse_invoice_extraction')?['currencyCode']",
                  "item/dpa_duedate": "@outputs('Parse_invoice_extraction')?['dueDate']",
                  "item/dpa_extractedlineitems": "@{if(empty(coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['items'], outputs('Parse_prompt_output')?['lineItems'])), null, substring(string(coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['items'], outputs('Parse_prompt_output')?['lineItems'])), 0, min(length(string(coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['items'], outputs('Parse_prompt_output')?['lineItems']))), 99000)))}",
                  "item/dpa_invoicedate": "@outputs('Parse_invoice_extraction')?['invoiceDate']",
                  "item/dpa_invoicenumber": "@outputs('Parse_invoice_extraction')?['invoiceNumber']",
                  "item/dpa_processedby": "@{if(equals(outputs('Get_invoice_row')?['body/dpa_extractionmethod'], 100000000), 'Native AI Builder Invoice Model', 'AI Builder Invoice Custom Prompt')}",
                  "item/dpa_processingcompletedon": "@{utcNow()}",
                  "item/dpa_processingerrorcode": "",
                  "item/dpa_processingerrormessage": "",
                  "item/dpa_purchaseordernumber": "@outputs('Parse_invoice_extraction')?['purchaseOrderNumber']",
                  "item/dpa_rawextractionresult": "@{if(empty(coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields'], body('Run_a_prompt'))), null, substring(string(coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields'], body('Run_a_prompt'))), 0, min(length(string(coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields'], body('Run_a_prompt')))), 99000)))}",
                  "item/dpa_subtotal": "@outputs('Parse_invoice_extraction')?['subTotal']",
                  "item/dpa_taxamount": "@outputs('Parse_invoice_extraction')?['taxAmount']",
                  "item/dpa_totalamount": "@outputs('Parse_invoice_extraction')?['totalAmount']",
                  "item/dpa_vendoraddress": "@outputs('Parse_invoice_extraction')?['vendorAddress']",
                  "item/dpa_vendorname": "@outputs('Parse_invoice_extraction')?['vendorName']",
                  "item/dpa_vendortaxnumber": "@outputs('Parse_invoice_extraction')?['vendorTaxNumber']",
                  "item/dpa_invoicename": "@{if(empty(trim(concat(coalesce(outputs('Parse_invoice_extraction')?['vendorName'], ''), if(empty(outputs('Parse_invoice_extraction')?['invoiceDate']), '', concat(' · ', formatDateTime(outputs('Parse_invoice_extraction')?['invoiceDate'], 'yyyy-MM-dd'))), if(equals(outputs('Parse_invoice_extraction')?['totalAmount'], null), '', concat(' · ', formatNumber(outputs('Parse_invoice_extraction')?['totalAmount'], 'F2'), if(empty(coalesce(outputs('Parse_invoice_extraction')?['currencyCode'], '')), '', concat(' ', coalesce(outputs('Parse_invoice_extraction')?['currencyCode'], '')))))))), null, trim(concat(coalesce(outputs('Parse_invoice_extraction')?['vendorName'], ''), if(empty(outputs('Parse_invoice_extraction')?['invoiceDate']), '', concat(' · ', formatDateTime(outputs('Parse_invoice_extraction')?['invoiceDate'], 'yyyy-MM-dd'))), if(equals(outputs('Parse_invoice_extraction')?['totalAmount'], null), '', concat(' · ', formatNumber(outputs('Parse_invoice_extraction')?['totalAmount'], 'F2'), if(empty(coalesce(outputs('Parse_invoice_extraction')?['currencyCode'], '')), '', concat(' ', coalesce(outputs('Parse_invoice_extraction')?['currencyCode'], ''))))))))}"
                }
              },
              "description": "Successful completion: stamp Completed, record which path produced the values, store the compact raw result and leave the error columns blank."
            },
            "Parse_invoice_extraction": {
              "runAfter": {
                "Parse_prompt_output": [
