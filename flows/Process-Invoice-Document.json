              "inputs": "@if(empty(body('Run_a_prompt')?['responsev2']?['predictionOutput']?['text']), null, json(body('Run_a_prompt')?['responsev2']?['predictionOutput']?['text']))",
              "description": "Parse the custom prompt JSON once. Null when the native branch ran, which lets every column fall back cleanly."
            }
          },
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "8f2a1c10-0004-4a10-9b10-000000000004"
          },
          "type": "Scope",
          "description": "Try: claim the row, read the document, extract, and write the results back."
        },
        "Catch_mark_invoice_failed": {
          "actions": {
            "Collect_failure_detail": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "8f2a1c10-0014-4a10-9b10-000000000014"
              },
              "type": "Compose",
              "inputs": "@result('Try_process_invoice')",
              "description": "Capture the most useful available error detail from the failed scope."
            },
            "Mark_invoice_failed": {
              "runAfter": {
                "Compose_error_message": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "8f2a1c10-0015-4a10-9b10-000000000015"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord"
                },
                "parameters": {
                  "entityName": "dpa_invoices",
                  "recordId": "@triggerOutputs()?['body/dpa_invoiceid']",
                  "item/dpa_processingstatus": 100000004,
                  "item/dpa_processingcompletedon": "@{utcNow()}",
                  "item/dpa_processingerrorcode": "@{coalesce(first(body('Filter_failed_actions'))?['code'], 'PROCESSING_FAILED')}",
                  "item/dpa_processingerrormessage": "@{substring(outputs('Compose_error_message'), 0, min(length(outputs('Compose_error_message')), 3900))}"
                }
              },
              "description": "Never leave the row in Processing: stamp Failed with a user-readable error, preserving the attempt count and run id."
            },
            "Terminate_as_failed": {
              "runAfter": {
                "Mark_invoice_failed": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "metadata": {
                "operationMetadataId": "8f2a1c10-0016-4a10-9b10-000000000016"
              },
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "INVOICE_PROCESSING_FAILED",
                  "message": "Invoice processing failed. The record was set to Failed with diagnostics."
                }
              }
            },
            "Filter_failed_actions": {
              "runAfter": {
                "Collect_failure_detail": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "aa11bb22-0001-4000-9000-000000000101"
              },
              "type": "Query",
              "inputs": {
                "from": "@outputs('Collect_failure_detail')",
                "where": "@equals(item()?['status'], 'Failed')"
              },
              "description": "Pick the action that actually failed, so the record carries the real cause rather than the first step of the scope."
            },
            "Compose_error_message": {
              "runAfter": {
                "Filter_failed_actions": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "aa11bb22-0002-4000-9000-000000000102"
              },
              "type": "Compose",
              "inputs": "@concat('Action \"', coalesce(first(body('Filter_failed_actions'))?['name'], 'unknown'), '\" failed with ', coalesce(first(body('Filter_failed_actions'))?['code'], 'an unspecified error'), '. ', coalesce(first(body('Filter_failed_actions'))?['error']?['message'], 'See the flow run identified by Last Processing Run ID for details.'))",
              "description": "Build a user-readable explanation naming the failing action and its error."
            }
          },
          "runAfter": {
            "Try_process_invoice": [
              "Failed",
              "TimedOut",
              "Skipped"
            ]
          },
          "metadata": {
            "operationMetadataId": "8f2a1c10-0013-4a10-9b10-000000000013"
          },
          "type": "Scope",
          "description": "Catch: the row is always moved out of Processing, with diagnostics written to the record."
        }
      },
      "runAfter": {
        "Get_invoice_row": [
          "Succeeded"
        ]
      },
      "else": {
        "actions": {
          "Skip_not_ready": {
            "runAfter": {},
            "metadata": {
              "operationMetadataId": "8f2a1c10-0017-4a10-9b10-000000000017"
            },
            "type": "Terminate",
            "inputs": {
              "runStatus": "Succeeded"
            },
            "description": "The row is no longer Ready to Process — another run already claimed it. Exit without processing."
          }
        }
      },
      "expression": {
        "and": [
          {
            "equals": [
              "@outputs('Get_invoice_row')?['body/dpa_processingstatus']",
