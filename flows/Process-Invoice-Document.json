          }
        ]
      },
      "metadata": {
        "operationMetadataId": "8f2a1c10-0003-4a10-9b10-000000000003"
      },
      "type": "If",
      "description": "Idempotency guard: only the run that still sees Ready to Process proceeds."
    }
  }
