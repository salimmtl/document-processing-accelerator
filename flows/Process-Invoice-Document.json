                "purchaseOrderNumber": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['purchaseOrder']?['valueText'], outputs('Parse_prompt_output')?['purchaseOrderNumber'])",
                "vendorName": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['vendorName']?['valueText'], outputs('Parse_prompt_output')?['vendorName'])",
                "vendorAddress": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['vendorAddress']?['valueText'], outputs('Parse_prompt_output')?['vendorAddress'])",
                "vendorTaxNumber": "@outputs('Parse_prompt_output')?['vendorTaxNumber']",
                "billToName": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['customerName']?['valueText'], outputs('Parse_prompt_output')?['billToName'])",
                "billToAddress": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['billingAddress']?['valueText'], outputs('Parse_prompt_output')?['billToAddress'])",
                "invoiceDate": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['invoiceDate']?['valueDate'], outputs('Parse_prompt_output')?['invoiceDate'])",
                "dueDate": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['dueDate']?['valueDate'], outputs('Parse_prompt_output')?['dueDate'])",
                "subTotal": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['subTotal']?['valueNumber'], outputs('Parse_prompt_output')?['subTotal'])",
                "taxAmount": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['totalTax']?['valueNumber'], outputs('Parse_prompt_output')?['taxAmount'])",
                "totalAmount": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['invoiceTotal']?['valueNumber'], outputs('Parse_prompt_output')?['totalAmount'])",
                "amountDue": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['amountDue']?['valueNumber'], outputs('Parse_prompt_output')?['amountDue'])",
                "currencyCode": "@coalesce(body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['invoiceTotal']?['currencyCode'], body('Process_invoices')?['responsev2']?['predictionOutput']?['result']?['fields']?['subTotal']?['currencyCode'], outputs('Parse_prompt_output')?['currencyCode'])"
              },
              "description": "Normalize whichever branch ran into one typed object: coalesce(native model, custom prompt)."
            },
            "Parse_prompt_output": {
              "type": "Compose",
              "runAfter": {
                "Switch_on_extraction_method": [
